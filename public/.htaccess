# updates.thestreamchurch.org is a static Astro site served by Apache behind Cloudflare.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the origin encrypted even when a request reaches it directly.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Serve Astro's branded not-found page instead of Apache's default response.
ErrorDocument 404 /404.html

# Not every LiteSpeed/Apache build maps .woff2 yet, and the Expires/Cache-Control
# rules below only fire once the type is known.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  # /llms.txt and the per-update .md copies are Spanish text; declare UTF-8 so accents survive.
  AddType text/markdown .md
  AddCharset utf-8 .txt .md
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/markdown text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  # woff2 is already Brotli-compressed; re-compressing it burns CPU for nothing.
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Public images keep hand-authored filenames, so let browsers revalidate them.
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # Self-hosted fonts carry a content hash in the filename, so they can be
  # cached permanently too. Renaming on regeneration is what makes this safe.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Astro fingerprints build output. Those files are safe to cache permanently.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Pages and machine-readable indexes should reflect a deploy immediately.
  <FilesMatch "\.(html|xml|json|txt|md)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>
