---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpdateCard from '../components/UpdateCard.astro';
import { canonicalForSlug, getPublishedUpdates } from '../lib/updates';
import { buildHomeJsonLd } from '../lib/seo';
import { SHARE_IMAGE, shareImagePath } from '../lib/images';

const now = new Date();
const updates = await getPublishedUpdates(now);
const featured = updates.find((update) => update.data.featured) ?? null;
const recent = featured ? updates.filter((update) => update.id !== featured.id) : updates;
const shareImage = featured ?? updates[0] ?? null;
const jsonLd = buildHomeJsonLd(updates.map((u) => ({ title: u.data.title, url: canonicalForSlug(u.data.slug) })));
---
<BaseLayout
  title="Updates: eventos y noticias de The Stream Church"
  description="Eventos, anuncios, misiones y testimonios de The Stream Church, iglesia bautista hispana en Warren, New Jersey. Entérate de lo próximo y acompáñanos."
  canonical="https://updates.thestreamchurch.org/"
  image={shareImage ? shareImagePath(shareImage.data.image) : undefined}
  imageAlt={shareImage?.data.imageAlt}
  imageWidth={shareImage ? SHARE_IMAGE.width : undefined}
  imageHeight={shareImage ? SHARE_IMAGE.height : undefined}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="updates-hero">
    <div class="shell updates-hero-grid">
      <div>
        <p class="eyebrow">The Stream Church</p>
        <h1>Updates</h1>
      </div>
      <p class="updates-hero-lede">Eventos, anuncios y momentos importantes de nuestra iglesia, presentados en un solo lugar y con una página diseñada especialmente para cada historia.</p>
    </div>
  </section>

  {featured ? (
    <section class="shell featured-section" aria-labelledby="featured-title">
      <div class="section-heading"><span>Destacado</span><h2 id="featured-title">Lo más reciente en The Stream</h2></div>
      <UpdateCard update={featured} now={now} priority />
    </section>
  ) : null}

  <section class="shell recent-section" aria-labelledby="recent-title">
    <div class="section-heading"><span>Actualizaciones</span><h2 id="recent-title">Noticias y eventos recientes</h2></div>
    {recent.length > 0 ? (
      <div class="updates-grid">{recent.map((update) => <UpdateCard update={update} now={now} />)}</div>
    ) : (
      <div class="empty-updates">
        <p class="eyebrow">Muy pronto</p>
        <h3>Estamos preparando nuestras primeras actualizaciones.</h3>
        <p>Vuelve pronto para conocer los próximos eventos, testimonios y noticias de The Stream Church.</p>
      </div>
    )}
  </section>
</BaseLayout>
