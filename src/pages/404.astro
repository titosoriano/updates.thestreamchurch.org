---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" description="La página que buscas no está disponible en The Stream Church Updates." robots="noindex, follow">
  <section class="error-page shell">
    <p class="eyebrow">404</p>
    <h1>Esta página no está aquí.</h1>
    <p>Puede que la actualización haya cambiado o que el enlace esté incompleto.</p>
    <div class="button-row">
      <a class="button button-primary" href="/">Ver Updates</a>
      <a class="button button-secondary" href="https://thestreamchurch.org/">Ir a The Stream Church</a>
    </div>
  </section>
</BaseLayout>
