---
const isHome = Astro.url.pathname === '/';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="The Stream Church Updates: inicio">
      <img src="/images/logo.webp" width="44" height="44" alt="" fetchpriority="high" />
      <span class="brand-name"><small>The Stream Church</small><strong>Updates</strong></span>
    </a>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Navegación de Updates">
      <div class="nav-local">
        <a href="/" aria-current={isHome ? 'page' : undefined}>Inicio</a>
        <a href="/#actualizaciones">Actualizaciones</a>
      </div>
      <a class="nav-church" href="https://thestreamchurch.org/">
        Sitio de la iglesia
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </nav>
  </div>
</header>
<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      nav.classList.toggle('is-open', open);
    };
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) { setOpen(false); toggle.focus(); }
    });

    // Dismissing by tapping outside is expected on touch; without it the
    // drawer could only be closed from the toggle itself.
    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      if (nav.contains(event.target) || toggle.contains(event.target)) return;
      setOpen(false);
    });

    nav.addEventListener('click', (event) => {
      if (event.target.closest('a')) setOpen(false);
    });

    // A resize into the desktop layout must not leave stale open state behind.
    const desktop = window.matchMedia('(min-width: 900px)');
    desktop.addEventListener('change', (event) => { if (event.matches) setOpen(false); });
  }
</script>
