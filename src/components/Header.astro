---
const navItems = [
  ['Inicio', 'https://thestreamchurch.org/'],
  ['Quiénes somos', 'https://thestreamchurch.org/mision-vision'],
  ['Servicios', 'https://thestreamchurch.org/#servicios'],
  ['Ministerios', 'https://thestreamchurch.org/obras-y-misiones'],
  ['Eventos', 'https://thestreamchurch.org/#eventos'],
  ['Recursos', 'https://thestreamchurch.org/confecion-de-fe-de-los-bautistas'],
  ['Visítanos', 'https://thestreamchurch.org/que-esperar'],
] as const;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/">
      <img src="/images/logo.webp" width="44" height="44" alt="" fetchpriority="high" />
      <span><small>Mission Baptist Church</small><strong>The Stream</strong></span>
    </a>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
      {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</header>
<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      nav.classList.toggle('is-open', open);
    };
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) { setOpen(false); toggle.focus(); }
    });

    // Dismissing by tapping outside is expected on touch; without it the
    // drawer could only be closed from the toggle itself.
    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      if (nav.contains(event.target) || toggle.contains(event.target)) return;
      setOpen(false);
    });

    nav.addEventListener('click', (event) => {
      if (event.target.closest('a')) setOpen(false);
    });

    // A resize into the desktop layout must not leave stale open state behind.
    const desktop = window.matchMedia('(min-width: 900px)');
    desktop.addEventListener('change', (event) => { if (event.matches) setOpen(false); });
  }
</script>
