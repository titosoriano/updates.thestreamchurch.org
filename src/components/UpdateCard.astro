---
import { cardDate, formatContentDate } from '../lib/dates';
import { responsiveSrcset } from '../lib/images';

interface Props {
  update: {
    data: {
      title: string;
      slug: string;
      description: string;
      category: string;
      publishDate: Date;
      image: string;
      imageAlt: string;
      eventDate?: Date;
    };
  };
  now?: Date;
  priority?: boolean;
}
const { update, now = new Date(), priority = false } = Astro.props;
const { data } = update;
const displayDate = cardDate(data);
const formattedDate = formatContentDate(displayDate);
const upcoming = data.eventDate ? data.eventDate.getTime() >= now.getTime() : false;
---
<article class="update-card">
  <a class="update-card-media" href={`/${data.slug}`} tabindex="-1" aria-hidden="true">
    <img
      src={data.image}
      srcset={responsiveSrcset(data.image, 1600)}
      alt=""
      width="1600"
      height="919"
      sizes="(min-width: 1200px) 33vw, (min-width: 900px) 50vw, 100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
    {upcoming && <span class="upcoming-badge">Próximo evento</span>}
  </a>
  <div class="update-card-body">
    <div class="update-meta"><span>{data.category}</span><time datetime={displayDate.toISOString().slice(0, 10)}>{formattedDate}</time></div>
    <h3><a href={`/${data.slug}`}>{data.title}</a></h3>
    <p>{data.description}</p>
    <a class="text-link" href={`/${data.slug}`}>Ver actualización <span aria-hidden="true">→</span></a>
  </div>
</article>
